# ─────────────────────────────────────────────────────────────────────────────
# Devosfera — 环境变量
# 将本文件复制为 .env 并填入你自己的值。
# .env 已被 git 忽略——不要把个人隐私数据提交到代码仓库。
# ─────────────────────────────────────────────────────────────────────────────

# ── 社交链接（个人主页侧栏 & 页脚） ─────────────────────────────────────────
# 留空（或删除该行）即可隐藏对应入口。

PUBLIC_SOCIAL_GITHUB=https://github.com/your-username
PUBLIC_SOCIAL_X=https://x.com/your-handle
PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/in/your-profile
PUBLIC_SOCIAL_EMAIL=your@email.com

# ── 「编辑本文」按钮 ───────────────────────────────────────────────────────
# 你的仓库 edit 页面的完整前缀，文章相对路径会自动拼接。
# GitHub 示例：https://github.com/your-username/your-repo/edit/main/
PUBLIC_EDIT_POST_URL=https://github.com/your-username/your-repo/edit/main/

# ── Google Search Console 验证标记（可选） ─────────────────────────────────
# PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-token
